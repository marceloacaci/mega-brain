# ============================================================================
# MEGA BRAIN — Exemplo de variáveis de ambiente
# COPIE para `.env` e PREENCHA. NUNCA comite o `.env` (já está no .gitignore do sistema,
# mas este arquivo de exemplo fica na raiz do repo de código, sem segredos reais).
# ============================================================================

# --- Caminho do vault (alvo da automação, fora do Git) ---
# Windows:
VAULT_ROOT=D:\Programas (Disco D)\Obsidian\cofres\Marcelo IA Skills
# Linux/macOS (validação em contêiner):
# VAULT_ROOT=/vault

# --- MCP server ---
MCP_HOST=127.0.0.1
MCP_PORT=8770
MCP_LOG_LEVEL=INFO

# --- Cache de consultas (roadmap M3; deixe vazio para desabilitar) ---
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=300

# --- Observabilidade (roadmap M3) ---
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- LLM / IA semântica (usado apenas em v2.0; nunca hardcode a chave) ---
LLM_PROVIDER=
# LLM_API_KEY=            # NÃO preencha aqui; use secret do CI ou var de ambiente do OS
EMBEDDING_MODEL=
EMBEDDING_DIM=

# --- Hermes Agent ---
HERMES_PROFILE=default

# --- Backups (robocopy) ---
BACKUP_ROOT=D:\Backups\Obsidian
BACKUP_RETENTION_DAYS=30

# --- Observabilidade / logs ---
LOG_DIR=80_SYSTEM/LOGS
LOG_FORMAT=json
